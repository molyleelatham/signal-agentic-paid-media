# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/signal
DATABASE_SYNC_URL=postgresql://user:password@localhost:5432/signal

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
TAVILY_API_KEY=your_tavily_api_key
THRAD_API_KEY=your_thrad_api_key
OVERMIND_API_KEY=your_overmind_api_key
OPENAI_API_KEY=your_openai_api_key

# Meta MCP + Ads Manager (Marketing API)
META_MCP_ENDPOINT=mcp://meta/ads
META_ADS_ACCESS_TOKEN=

# Google Ads API (leave empty for demo mode)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Cursor Agent SDK — agent runtime only (Composer 2.5)
# Used by SIGNAL agents and Overmind agent validate/baseline/eval runs.
CURSOR_API_KEY=cursor_your_api_key
CURSOR_MODEL=composer-2.5
# Optional: workspace root for local agents (defaults to project root)
# CURSOR_AGENT_CWD=/path/to/adtech-hackathon

# OpenAI — Overmind setup/optimize analyzer and synthetic datagen (see docs/LLM_ARCHITECTURE.md)
# Also used as BaseAgent fallback when CURSOR_API_KEY is unset.

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Token Settings
TOKEN_INITIAL_SUPPLY=1000000
TOKEN_DECIMAL_PLACES=8
TOKEN_ISSUANCE_RATE=0.1  # tokens per $10 revenue
TOKEN_BURN_RATE=0.05  # tokens per $20 loss (with 2x loss aversion)

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Overmind
OVERMIND_PROJECT_ID=your_overmind_project_id
OVERMIND_ENVIRONMENT=development
OVERMIND_SERVICE_NAME=signal-platform